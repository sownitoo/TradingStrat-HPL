# Copier ce fichier en `.env` (déjà ignoré par git) puis remplir les valeurs.
# chmod 600 .env

# Clé privée de l'API wallet (agent wallet) créée sur https://app.hyperliquid.xyz/API
# Ce N'EST PAS la clé de votre wallet principal : l'agent peut trader mais pas retirer de fonds.
HL_SECRET_KEY=0x...

# Adresse publique de votre compte PRINCIPAL (celui qui détient les fonds et les positions),
# pas l'adresse de l'agent wallet.
HL_ACCOUNT_ADDRESS=0x...

# mainnet ou testnet
HL_NETWORK=mainnet

# Taille de la position en USD (notionnel). Levier fixé à 1x dans le code.
POSITION_SIZE_USD=500

# Slippage max accepté pour les ordres au marché (IOC), 0.01 = 1 %
SLIPPAGE=0.01

# Mode de marge sur xyz:SP500 : isolated (recommandé) ou cross
MARGIN_MODE=isolated

# Fichier de log (relatif au dossier du projet)
LOG_FILE=logs/rsi2_bot.log
